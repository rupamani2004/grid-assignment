<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Masai Investors</title>

    <style>
        body{
            font-family: Arial, sans-serif;
            padding: 20px;
        }

        h1{
            text-align: center;
            margin-bottom: 30px;
        }

        
        .grid{
            display: grid;
            grid-template-columns: repeat(4, 1fr); 
            gap: 20px;
        }

        
        .card{
            border: 1px solid #ccc;
            border-radius: 10px;
            overflow: hidden;
            background: #fff;
        }

        .card img{
            width: 100%;
            height: 250px;
            object-fit: cover;
        }

        .info{
            padding: 15px;
        }

        .info h3{
            margin: 0;
        }

        .info p{
            margin: 5px 0;
            color: gray;
        }

        .company-logo{
            width: 80px;
            margin-top: 10px;
        }

        
        @media screen and (max-width: 992px){
            .grid{
                grid-template-columns: repeat(3, 1fr);
            }
        }

        
        @media screen and (max-width: 600px){
            .grid{
                grid-template-columns: repeat(2, 1fr);
            }
        }

    </style>
</head>
<body>

    <h1>Masai Investors</h1>

    <div class="grid">

        
        <div class="card">
            <img src="IMAGE_LINK_1" alt="">
            <div class="info">
                <h3>Vijay Shekhar Sharma</h3>
                <p>Founder & CEO</p>
                <img class="company-logo" src="LOGO_LINK_1">
            </div>
        </div>

        
        <div class="card">
            <img src="IMAGE_LINK_2" alt="">
            <div class="info">
                <h3>Kunal Shah</h3>
                <p>Founder</p>
                <img class="company-logo" src="LOGO_LINK_2">
            </div>
        </div>

        
        <div class="card">
            <img src="IMAGE_LINK_3" alt="">
            <div class="info">
                <h3>Amrish Rau</h3>
                <p>CEO</p>
                <img class="company-logo" src="LOGO_LINK_3">
            </div>
        </div>

    

    </div>

</body>
</html>
